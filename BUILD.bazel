load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "go_binary", "go_cross_binary", "go_library", "go_test", "nogo")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/nogo:staticcheck.bzl", "STATICCHECK")

# gazelle:prefix github.com/bpalermo/kms-intermediate-rotator
#
# The configuration schema (config/v1) imports the protovalidate annotations:
# their proto_library is the protovalidate module's, and their Go package the
# buf.build/gen/go module of go.mod.
# gazelle:resolve proto buf/validate/validate.proto @protovalidate//proto/protovalidate/buf/validate:validate_proto
# gazelle:resolve proto go buf/validate/validate.proto @build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate

gazelle(name = "gazelle")

# The analyzers every Go package is compiled with (see go_sdk.nogo in
# MODULE.bazel): the ones `go vet` runs, the rest of the x/tools set that
# rules_go recommends, and staticcheck.
nogo(
    name = "nogo",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO + STATICCHECK,
)

exports_files([
    ".shellcheckrc",
    # Its example configuration is parsed by //config:config_test.
    "README.md",
    # The release being worked towards; see bazel/workspace_status.sh.
    "VERSION",
    # The buf configuration: its lint rules (//config/v1) and its
    # breaking-change rules (scripts/proto-breaking.sh).
    "buf.yaml",
])

alias(
    name = "format",
    actual = "//bazel/format",
)

alias(
    name = "format.check",
    actual = "//bazel/format:format.check",
)

go_library(
    name = "kms-intermediate-rotator_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/kms-intermediate-rotator",
    visibility = ["//visibility:private"],
    deps = [
        "//config",
        "//internal/version",
        "//kmssigner",
        "//rotation",
        "@com_github_aws_aws_lambda_go//lambda",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_kms//:kms",
        "@com_github_aws_aws_sdk_go_v2_service_secretsmanager//:secretsmanager",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
    ],
)

# The Lambda, for the provided.al2023 custom runtime, which starts the
# executable named `bootstrap`. Pure Go: statically linked, no cgo.
go_binary(
    name = "rotator",
    basename = "bootstrap",
    embed = [":kms-intermediate-rotator_lib"],
    # aws-lambda-go without its legacy net/rpc mode, which provided.al2023
    # never uses.
    gotags = ["lambda.norpc"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "kms-intermediate-rotator_test",
    srcs = ["main_test.go"],
    embed = [":kms-intermediate-rotator_lib"],
    deps = ["//rotation"],
)

# The release archives, one per architecture of the Lambda runtime
# (release.yml attaches them to the GitHub Release of a v* tag as
# kms-intermediate-rotator_<version>_linux_<arch>.zip). Each is :rotator built
# for one platform, stamped like every binary (//internal/version), so a
# release build reports its tag. Keep the list equal to the one in release.yml.
[
    [
        go_cross_binary(
            name = "rotator_" + platform,
            platform = "//bazel/platforms:" + platform,
            target = ":rotator",
            visibility = ["//visibility:public"],
        ),
        # The file lands in the zip as `bootstrap`, executable.
        pkg_files(
            name = "files_" + platform,
            srcs = [":rotator_" + platform],
            attributes = pkg_attributes(mode = "0755"),
            renames = {":rotator_" + platform: "bootstrap"},
        ),
        # pkg_zip stamps every entry with a fixed timestamp (1980-01-01) and
        # sorts nothing it was not given, so the same inputs give the same
        # bytes. The version is in the file name release.yml gives the zip
        # and in the binary, not in the archive's metadata.
        pkg_zip(
            name = "zip_" + platform,
            srcs = [":files_" + platform],
            out = "kms-intermediate-rotator_linux_" + platform.removeprefix("linux_") + ".zip",
            visibility = ["//visibility:public"],
        ),
    ]
    for platform in [
        "linux_amd64",
        "linux_arm64",
    ]
]

# Each archive holds one file, `bootstrap`, executable, and that file is a
# static executable of the architecture the archive is named for.
sh_test(
    name = "release_zips_test",
    size = "small",
    srcs = ["release_zips_test.sh"],
    args = [
        "linux_amd64=$(rootpath :zip_linux_amd64)",
        "linux_arm64=$(rootpath :zip_linux_arm64)",
    ],
    data = [
        ":zip_linux_amd64",
        ":zip_linux_arm64",
    ],
)
