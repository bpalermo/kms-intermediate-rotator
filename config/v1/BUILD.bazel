load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# The configuration schema. Gazelle generates the proto_library and the
# go_proto_library; the generated Go is not committed: the schema is this
# repository's alone, and Bazel is its only build.

proto_library(
    name = "configv1_proto",
    srcs = ["config.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protovalidate//proto/protovalidate/buf/validate:validate_proto"],
)

go_proto_library(
    name = "configv1_go_proto",
    importpath = "github.com/bpalermo/kms-intermediate-rotator/config/v1",
    proto = ":configv1_proto",
    visibility = ["//visibility:public"],
    deps = ["@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate"],
)

go_library(
    name = "config",
    embed = [":configv1_go_proto"],
    importpath = "github.com/bpalermo/kms-intermediate-rotator/config/v1",
    visibility = ["//visibility:public"],
)

# The STANDARD and COMMENTS rules of //:buf.yaml.
buf_lint_test(
    name = "config_proto_lint_test",
    size = "small",
    config = "//:buf.yaml",
    targets = [":configv1_proto"],
)
