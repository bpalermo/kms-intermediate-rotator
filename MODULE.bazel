module(
    name = "kms-intermediate-rotator",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")

# pkg_zip, for the release archives (//cmd/rotator). Older versions use the
# removed incompatible_use_toolchain_transition keyword.
bazel_dep(name = "rules_pkg", version = "1.3.0")

# Named by bazel/lint's gocognit aspect for its public setting types, and
# already in the graph through rules_go; declared so a bump cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# sh_library and sh_test for the scripts under //bazel.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The cosign CLI -- only the CLI. @rules_img_signer_cosign//cosign is the
# official prebuilt release binary, selected per platform, with its sha256
# pinned in the module's own lock. //bazel/cosign wraps it so the release
# workflow signs the checksums with that checksummed binary. No image is built
# here: this module is the cosign release only.
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go and
# shell; //bazel/lint has the shellcheck and gocognit aspects.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# The Go toolchain, from go.mod's `go` line.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "co_honnef_go_tools", "com_github_uudashr_gocognit")
